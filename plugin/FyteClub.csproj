<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>FyteClub</AssemblyName>
    <Version>5.0.10</Version>
    <PackageProjectUrl>https://github.com/fyteclubplugin/fyteclub</PackageProjectUrl>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- Suppress platform-specific warnings since this is a Windows-only FFXIV plugin -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Enable QUIC support -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WebRTC P2P - no IP exposure -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src\FyteClubPluginSimple.cs" />
    <Compile Remove="src\FyteClubPluginMinimal.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="mrwebrtc.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.MixedReality.WebRTC\Microsoft.MixedReality.WebRTC.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NNostr.Client" Version="0.0.54" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="7.0.1" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="src\WebRTCConnection.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Penumbra.Api" Version="5.15.1" />
    <PackageReference Include="Glamourer.Api" Version="2.8.2" />
  </ItemGroup>

</Project>
